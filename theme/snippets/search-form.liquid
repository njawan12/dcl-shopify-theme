<predictive-search data-url="{{ routes.predictive_search_url }}" data-error="{{ 'search.unavailable' | t }}">
  <form action="{{ routes.search_url }}" method="get" role="search">
    <label for="Search-{{ section.id }}">{{ 'general.search' | t }}</label>
    <input id="Search-{{ section.id }}" name="q" type="search" value="{{ search.terms | escape }}" autocomplete="off" aria-describedby="SearchHelp-{{ section.id }}">
    <button>{{ 'general.search' | t }}</button>
  </form>
  <p id="SearchHelp-{{ section.id }}" class="muted">{{ 'search.help' | t }}</p>
  <div data-predictions hidden></div><p role="status" data-search-status></p>
</predictive-search>
<script type="module" src="{{ 'search.js' | asset_url }}"></script>
