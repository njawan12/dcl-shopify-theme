{% if image %}
  {%- capture focal -%}{% if image.presentation.focal_point %}object-position: {{ image.presentation.focal_point }};{% endif %}{%- endcapture -%}
  {% assign image_loading = 'lazy' %}{% if eager %}{% assign image_loading = 'eager' %}{% endif %}
  {{ image | image_url: width: 1600 | image_tag: widths: '240,360,540,720,960,1200,1600', sizes: sizes, loading: image_loading, alt: alt, class: 'responsive-image', style: focal }}
{% else %}<div class="media-placeholder">{{ 'general.no_media' | t }}</div>{% endif %}
