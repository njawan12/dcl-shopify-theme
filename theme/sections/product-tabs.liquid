{%- liquid
  assign s = section.settings
  assign scheme = s.scheme | remove: 'scheme'
  assign tab_count = section.blocks.size
-%}
<section class="product-tabs scheme-{{ scheme }} section-space" {% if s.heading != blank %}aria-labelledby="Heading-{{ section.id }}"{% endif %}>
  <tab-set class="page-width">
    <div class="section-head section-head--split">
      <div class="section-intro">
        {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 id="Heading-{{ section.id }}">{{ s.heading | escape }}</h2>{%- endif -%}
      </div>
      {%- if tab_count > 1 -%}
        <div class="product-tabs__tabs">
          <div class="tab-list" role="tablist" aria-label="{{ s.heading | escape }}">
            {%- for block in section.blocks -%}
              {%- assign c = block.settings.collection -%}
              <a href="{% if c %}{{ c.url }}{% else %}{{ routes.all_products_collection_url }}{% endif %}" class="tab" role="tab" id="Tab-{{ section.id }}-{{ forloop.index }}" aria-controls="Panel-{{ section.id }}-{{ forloop.index }}" aria-selected="{% if forloop.first %}true{% else %}false{% endif %}" {{ block.shopify_attributes }}>
                {%- if block.settings.label != blank -%}{{ block.settings.label | escape }}{%- elsif c != blank -%}{{ c.title | escape }}{%- else -%}{{ 'canvas.sample_collection' | t }}{%- endif -%}
              </a>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}
    </div>
    {%- for block in section.blocks -%}
      {%- assign c = block.settings.collection -%}
      {%- assign card_scope = section.id | append: '-' | append: forloop.index -%}
      <div class="product-tabs__panel" {% if tab_count > 1 %}role="tabpanel" id="Panel-{{ section.id }}-{{ forloop.index }}" aria-labelledby="Tab-{{ section.id }}-{{ forloop.index }}"{% unless forloop.first %} hidden{% endunless %}{% endif %}>
        <slide-track class="carousel{% if s.layout == 'grid' %} carousel--grid{% endif %}" style="--columns: {{ s.columns }}">
          <ul class="carousel__track" data-track role="list">
            {%- if c != blank and c.products_count > 0 -%}
              {%- for product in c.products limit: s.limit -%}
                <li class="carousel__item">{% render 'product-card', product: product, scope: card_scope %}</li>
              {%- endfor -%}
            {%- else -%}
              {%- for i in (1..4) -%}
                <li class="carousel__item">
                  <article class="card"><div class="card__media">{{ 'product-' | append: i | placeholder_svg_tag: 'card__img card__placeholder' }}</div><div class="card__info"><h3 class="card__title">{{ 'canvas.sample_product' | t }}</h3><div class="card__price">{{ 1900 | money }}</div></div></article>
                </li>
              {%- endfor -%}
            {%- endif -%}
          </ul>
          {%- if s.layout == 'carousel' -%}
            <div class="carousel__nav">
              <button type="button" class="carousel__arrow" data-track-prev>{% render 'icon', icon: 'chevron-left' %}<span class="visually-hidden">{{ 'general.previous' | t }}</span></button>
              <button type="button" class="carousel__arrow" data-track-next>{% render 'icon', icon: 'chevron-right' %}<span class="visually-hidden">{{ 'general.next' | t }}</span></button>
            </div>
          {%- endif -%}
        </slide-track>
        {%- if s.view_all and c != blank -%}
          <div class="section-foot"><a class="button button--outline" href="{{ c.url }}">{{ 'general.view_all' | t: title: c.title }}</a></div>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </tab-set>
</section>

{% schema %}
{
  "name": "t:sections.product_tabs",
  "tag": "div",
  "class": "section-product-tabs",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.eyebrow",
      "default": "Shop"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Bestsellers"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "t:settings.layout",
      "default": "carousel",
      "options": [
        {
          "value": "carousel",
          "label": "t:options.carousel"
        },
        {
          "value": "grid",
          "label": "t:options.grid"
        }
      ]
    },
    {
      "type": "range",
      "id": "limit",
      "label": "t:settings.products_to_show",
      "min": 2,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:settings.columns_desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "view_all",
      "label": "t:settings.view_all",
      "default": true
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "t:settings.scheme",
      "default": "scheme1",
      "options": [
        {
          "value": "scheme1",
          "label": "t:options.scheme1"
        },
        {
          "value": "scheme2",
          "label": "t:options.scheme2"
        },
        {
          "value": "scheme3",
          "label": "t:options.scheme3"
        },
        {
          "value": "scheme4",
          "label": "t:options.scheme4"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "tab",
      "name": "t:blocks.tab",
      "limit": 5,
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:settings.collection"
        },
        {
          "type": "text",
          "id": "label",
          "label": "t:settings.label"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.product_tabs",
      "blocks": [
        {
          "type": "tab"
        },
        {
          "type": "tab"
        }
      ]
    }
  ]
}
{% endschema %}
