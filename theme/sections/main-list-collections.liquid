<div class="page-width section-space">
  <h1>{{ 'collection.title' | t }}</h1>
  {%- paginate collections by 24 -%}
    <ul class="collection-tiles collection-tiles--3" role="list">
      {%- for collection in collections -%}
        <li class="collection-tile">
          <a href="{{ collection.url }}">
            {%- assign tile_image = collection.featured_image | default: collection.products.first.featured_media.preview_image -%}
            {%- render 'canvas-media', image: tile_image, sizes: '(min-width: 990px) 33vw, 50vw', eager: false, placeholder: 'collection-1' -%}
            <h2>{{ collection.title | escape }}</h2>
            <p class="collection-tile__count">{{ 'canvas.products_count' | t: count: collection.products_count }}</p>
          </a>
        </li>
      {%- else -%}
        <li><p>{{ 'collection.empty' | t }}</p></li>
      {%- endfor -%}
    </ul>
    {% render 'pagination', paginate: paginate %}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "t:sections.collections",
  "settings": []
}
{% endschema %}
