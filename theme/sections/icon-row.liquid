{%- liquid
  assign s = section.settings
  assign scheme = s.scheme | remove: 'scheme'
-%}
<section class="icon-row icon-row--{{ s.style }} scheme-{{ scheme }} section-space" {% if s.heading != blank %}aria-labelledby="Heading-{{ section.id }}"{% endif %}>
  <div class="page-width">
    {%- if s.heading != blank -%}
      <div class="section-intro section-intro--center">
        {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
        <h2 id="Heading-{{ section.id }}">{{ s.heading | escape }}</h2>
      </div>
    {%- endif -%}
    <ul class="icon-row__list" role="list" style="--items: {{ section.blocks.size }}">
      {%- for block in section.blocks -%}
        <li class="icon-row__item" {{ block.shopify_attributes }} data-reveal>
          {%- if block.settings.icon != 'none' -%}<span class="icon-row__icon">{% render 'icon', icon: block.settings.icon %}</span>{%- endif -%}
          {%- if block.settings.heading != blank -%}<h3>{{ block.settings.heading | escape }}</h3>{%- endif -%}
          {%- if block.settings.text != blank -%}<p>{{ block.settings.text | escape }}</p>{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.icon_row",
  "tag": "div",
  "class": "section-icon-row",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading"
    },
    {
      "type": "select",
      "id": "style",
      "label": "t:settings.style",
      "default": "plain",
      "options": [
        {
          "value": "plain",
          "label": "t:options.plain"
        },
        {
          "value": "cards",
          "label": "t:options.cards"
        },
        {
          "value": "divided",
          "label": "t:options.divided"
        }
      ]
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "t:settings.scheme",
      "default": "scheme2",
      "options": [
        {
          "value": "scheme1",
          "label": "t:options.scheme1"
        },
        {
          "value": "scheme2",
          "label": "t:options.scheme2"
        },
        {
          "value": "scheme3",
          "label": "t:options.scheme3"
        },
        {
          "value": "scheme4",
          "label": "t:options.scheme4"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "t:blocks.item",
      "limit": 6,
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "t:settings.icon",
          "default": "leaf",
          "options": [
            {
              "value": "none",
              "label": "t:icons.none"
            },
            {
              "value": "leaf",
              "label": "t:icons.leaf"
            },
            {
              "value": "drop",
              "label": "t:icons.drop"
            },
            {
              "value": "sparkle",
              "label": "t:icons.sparkle"
            },
            {
              "value": "shield",
              "label": "t:icons.shield"
            },
            {
              "value": "truck",
              "label": "t:icons.truck"
            },
            {
              "value": "return",
              "label": "t:icons.return"
            },
            {
              "value": "recycle",
              "label": "t:icons.recycle"
            },
            {
              "value": "heart",
              "label": "t:icons.heart"
            },
            {
              "value": "clock",
              "label": "t:icons.clock"
            },
            {
              "value": "gift",
              "label": "t:icons.gift"
            },
            {
              "value": "check",
              "label": "t:icons.check"
            },
            {
              "value": "lock",
              "label": "t:icons.lock"
            },
            {
              "value": "chat",
              "label": "t:icons.chat"
            },
            {
              "value": "sun",
              "label": "t:icons.sun"
            },
            {
              "value": "moon",
              "label": "t:icons.moon"
            },
            {
              "value": "flask",
              "label": "t:icons.flask"
            },
            {
              "value": "globe",
              "label": "t:icons.globe"
            },
            {
              "value": "rabbit",
              "label": "t:icons.rabbit"
            },
            {
              "value": "star",
              "label": "t:icons.star"
            }
          ]
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:settings.heading",
          "default": "Gentle by design"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:settings.text",
          "default": "Formulas built for sensitive skin."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.icon_row",
      "blocks": [
        {
          "type": "item",
          "settings": {
            "icon": "leaf",
            "heading": "Plant based",
            "text": "Botanical actives with nothing you don’t need."
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "rabbit",
            "heading": "Cruelty free",
            "text": "Never tested on animals."
          }
        },
        {
          "type": "item",
          "settings": {
            "icon": "recycle",
            "heading": "Refillable glass",
            "text": "Packaging made to be reused."
          }
        },
        {
          "type": "item",
