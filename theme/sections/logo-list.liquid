{%- liquid
  assign s = section.settings
  assign scheme = s.scheme | remove: 'scheme'
-%}
<section class="logo-list scheme-{{ scheme }} section-space" {% if s.heading != blank %}aria-labelledby="Heading-{{ section.id }}"{% endif %}>
  <div class="page-width">
    {%- if s.heading != blank -%}<h2 id="Heading-{{ section.id }}" class="logo-list__heading">{{ s.heading | escape }}</h2>{%- endif -%}
    <ul class="logos" role="list">
      {%- for block in section.blocks -%}
        <li class="logo" {{ block.shopify_attributes }}>
          {%- capture logo_inner -%}
            {%- if block.settings.image -%}
              {{ block.settings.image | image_url: width: 400 | image_tag: widths: '200,400', sizes: '160px', loading: 'lazy', alt: block.settings.name }}
            {%- else -%}
              <span class="logo__name">{{ block.settings.name | escape }}</span>
            {%- endif -%}
          {%- endcapture -%}
          {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ logo_inner }}</a>{%- else -%}{{ logo_inner }}{%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.logo_list",
  "tag": "div",
  "class": "section-logo-list",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "As featured in"
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "t:settings.scheme",
      "default": "scheme1",
      "options": [
        {
          "value": "scheme1",
          "label": "t:options.scheme1"
        },
        {
          "value": "scheme2",
          "label": "t:options.scheme2"
        },
        {
          "value": "scheme3",
          "label": "t:options.scheme3"
        },
        {
          "value": "scheme4",
          "label": "t:options.scheme4"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "t:blocks.logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:settings.image"
        },
        {
          "type": "text",
          "id": "name",
          "label": "t:settings.name",
          "default": "Publication"
        },
        {
          "type": "url",
          "id": "link",
          "label": "t:settings.link"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "t:sections.logo_list",
      "blocks": [
        {
          "type": "logo"
        },
        {
          "type": "logo"
        },
        {
          "type": "logo"
        },
        {
          "type": "logo"
        }
      ]
    }
  ]
}
{% endschema %}
