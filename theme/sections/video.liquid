{%- liquid
  assign s = section.settings
  assign scheme = s.scheme | remove: 'scheme'
-%}
<section class="video-section scheme-{{ scheme }} section-space" {% if s.heading != blank %}aria-labelledby="Heading-{{ section.id }}"{% endif %}>
  <div class="page-width">
    {%- if s.eyebrow != blank or s.heading != blank -%}
  <div class="section-intro">
    {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
    {%- if s.heading != blank -%}<h2 id="Heading-{{ section.id }}">{{ s.heading | escape }}</h2>{%- endif -%}
    {%- if s.text != blank -%}<div class="rich-text section-intro__text">{{ s.text }}</div>{%- endif -%}
  </div>
{%- endif -%}
    {%- assign video_title = s.heading -%}{%- if video_title == blank -%}{%- assign video_title = 'canvas.video_title' | t -%}{%- endif -%}
    <div class="video-frame">
      {%- if s.video != blank -%}
        {{ s.video | video_tag: controls: true, preload: 'none', playsinline: true, image_size: '1600x' }}
      {%- elsif s.video_url != blank -%}
        {%- if s.video_url.type == 'youtube' -%}
          <iframe src="https://www.youtube-nocookie.com/embed/{{ s.video_url.id }}" title="{{ video_title | escape }}" loading="lazy" allow="accelerometer; encrypted-media; picture-in-picture" allowfullscreen></iframe>
        {%- else -%}
          <iframe src="https://player.vimeo.com/video/{{ s.video_url.id }}" title="{{ video_title | escape }}" loading="lazy" allow="fullscreen; picture-in-picture" allowfullscreen></iframe>
        {%- endif -%}
      {%- else -%}
        <div class="canvas-placeholder">{{ 'hero-apparel-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.video",
  "tag": "div",
  "class": "section-video",
  "settings": [
    {
      "type": "video",
      "id": "video",
      "label": "t:settings.video"
    },
    {
      "type": "video_url",
      "id": "video_url",
      "label": "t:settings.video_url",
      "accept": [
        "youtube",
        "vimeo"
      ],
      "info": "t:info.video_url"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "See it in use"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:settings.text"
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "t:settings.scheme",
      "default": "scheme1",
      "options": [
        {
          "value": "scheme1",
          "label": "t:options.scheme1"
        },
        {
          "value": "scheme2",
          "label": "t:options.scheme2"
        },
        {
          "value": "scheme3",
          "label": "t:options.scheme3"
        },
        {
          "value": "scheme4",
          "label": "t:options.scheme4"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.video"
    }
  ]
}
{% endschema %}
