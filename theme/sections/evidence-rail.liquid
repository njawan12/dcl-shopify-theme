{% capture attachment %}
  {% for block in section.blocks %}
    {% if block.type == '@app' %}<div class="app-host" tabindex="0" role="region" aria-label="{{ 'general.evidence' | t }}" {{ block.shopify_attributes }}>{% render block %}</div>
    {% elsif block.type == 'evidence_note' and section.settings.attachment == 'note' %}{% render 'evidence-note', content: block.settings, block: block %}
    {% elsif block.type == 'evidence_process' and section.settings.attachment == 'process' %}{% render 'evidence-process', content: block.settings, block: block %}{% endif %}
  {% endfor %}
{% endcapture %}
{% if section.settings.heading != blank or section.settings.media != blank or attachment != blank %}
<section class="page-width section-space evidence-story">
  <div class="story-subject">
    {% if section.settings.heading != blank %}<h2>{{ section.settings.heading | escape }}</h2>{% endif %}
    {% if section.settings.introduction != blank %}<div class="rich-text">{{ section.settings.introduction }}</div>{% endif %}
    {% if section.settings.media != blank %}{% assign story_alt = section.settings.alt | default: section.settings.media.alt %}{% render 'image', image: section.settings.media, alt: story_alt, sizes: '(min-width: 990px) 40vw, 100vw', eager: false %}{% endif %}
  </div>
  <div class="story-proof">{{ attachment }}</div>
</section>
{% endif %}
