{%- liquid
  assign s = section.settings
  assign scheme = s.scheme | remove: 'scheme'
-%}
<section class="collection-list collection-list--{{ s.style | default: 'tiles' }} scheme-{{ scheme }} section-space" {% if s.heading != blank %}aria-labelledby="Heading-{{ section.id }}"{% endif %}>
  <div class="page-width">
    {%- if s.eyebrow != blank or s.heading != blank -%}
  <div class="section-intro">
    {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
    {%- if s.heading != blank -%}<h2 id="Heading-{{ section.id }}">{{ s.heading | escape }}</h2>{%- endif -%}
    {%- if s.text != blank -%}<div class="rich-text section-intro__text">{{ s.text }}</div>{%- endif -%}
  </div>
{%- endif -%}
    <ul class="collection-tiles collection-tiles--{{ section.blocks.size }}" role="list">
      {%- for block in section.blocks -%}
        {%- assign c = block.settings.collection -%}
        <li class="collection-tile" {{ block.shopify_attributes }}>
          {%- if c != blank -%}
            <a href="{{ c.url }}">
              {%- assign tile_image = block.settings.image | default: c.featured_image -%}
              {%- render 'canvas-media', image: tile_image, sizes: '(min-width: 990px) 33vw, 50vw', eager: false, placeholder: 'collection-1' -%}
              <h3>{{ c.title | escape }}</h3>
              <p class="collection-tile__count">{{ 'canvas.products_count' | t: count: c.products_count }}</p>
            </a>
          {%- else -%}
            {%- capture ph -%}collection-{{ forloop.index | modulo: 6 | plus: 1 }}{%- endcapture -%}
            {%- render 'canvas-media', image: nil, placeholder: ph -%}
            <h3>{{ 'canvas.sample_collection' | t }}</h3>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.collection_list",
  "tag": "div",
  "class": "section-collection-list",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Shop by need"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:settings.text"
    },
    {
      "type": "select",
      "id": "style",
      "label": "t:settings.style",
      "default": "tiles",
      "options": [
        {
          "value": "tiles",
          "label": "t:options.tiles"
        },
        {
          "value": "circles",
          "label": "t:options.circles"
        },
        {
          "value": "overlay",
          "label": "t:options.overlay"
        }
      ]
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "t:settings.scheme",
      "default": "scheme1",
      "options": [
        {
          "value": "scheme1",
          "label": "t:options.scheme1"
        },
        {
          "value": "scheme2",
          "label": "t:options.scheme2"
        },
        {
          "value": "scheme3",
          "label": "t:options.scheme3"
        },
        {
          "value": "scheme4",
          "label": "t:options.scheme4"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "t:settings.collection",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "t:settings.collection"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:settings.image_override"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "t:sections.collection_list",
      "blocks": [
        {
          "type": "collection"
        },
        {
          "type": "collection"
        },
        {
          "type": "collection"
        }
      ]
    }
  ]
}
{% endschema %}
