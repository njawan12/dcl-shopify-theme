{%- liquid
  assign s = section.settings
  assign has_banner = false
  if s.show_image and collection.image
    assign has_banner = true
  endif
-%}
<div class="collection-page">
  {%- if has_banner -%}
    <div class="collection-banner">
      {{ collection.image | image_url: width: 2400 | image_tag: widths: '750,1100,1500,2000,2400', sizes: '100vw', loading: 'eager', fetchpriority: 'high', alt: collection.image.alt, class: 'collection-banner__image' }}
      <div class="page-width collection-banner__content">
        <nav class="breadcrumbs" aria-label="{{ 'general.breadcrumbs' | t }}"><a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a><span aria-hidden="true">/</span><span aria-current="page">{{ collection.title | escape }}</span></nav>
        <h1>{{ collection.title | escape }}</h1>
        {%- if collection.description != blank -%}<div class="rich-text">{{ collection.description }}</div>{%- endif -%}
      </div>
    </div>
  {%- endif -%}
  <div class="page-width section-space collection-main" id="CollectionMain-{{ section.id }}">
    {%- unless has_banner -%}
      <div class="collection-head">
        <nav class="breadcrumbs" aria-label="{{ 'general.breadcrumbs' | t }}"><a href="{{ routes.root_url }}">{{ 'general.home' | t }}</a><span aria-hidden="true">/</span><span aria-current="page">{{ collection.title | escape }}</span></nav>
        <h1>{{ collection.title | escape }}</h1>
        {%- if collection.description != blank -%}<div class="rich-text">{{ collection.description }}</div>{%- endif -%}
      </div>
    {%- endunless -%}
    {% paginate collection.products by s.per_page %}
      {% render 'filters', collection: collection, section: section, count: collection.products_count %}
      <div class="product-grid product-grid--{{ s.columns }}" data-results>
        {%- for product in collection.products -%}
          {% render 'product-card', product: product, scope: section.id %}
        {%- else -%}
          <div class="collection-empty">
            <p>{{ 'collection.empty' | t }}</p>
            <a class="button" href="{{ collection.url }}">{{ 'collection.clear' | t }}</a>
          </div>
        {%- endfor -%}
      </div>
      {% render 'pagination', paginate: paginate %}
    {% endpaginate %}
  </div>
</div>

{% schema %}
{
  "name": "t:sections.collection",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "t:settings.show_collection_image",
      "default": true
    },
    {
      "type": "select",
      "id": "columns",
      "label": "t:settings.columns_desktop",
      "default": "4",
      "options": [
        {
          "value": "3",
          "label": "3"
        },
        {
          "value": "4",
          "label": "4"
        }
      ]
    },
    {
      "type": "range",
      "id": "per_page",
      "label": "t:settings.products_per_page",
      "min": 8,
      "max": 36,
      "step": 4,
      "default": 24
    }
  ]
}
{% endschema %}
