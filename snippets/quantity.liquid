{%- assign minimum = variant.quantity_rule.min | default: 1 -%}
{%- assign increment = variant.quantity_rule.increment | default: 1 -%}
<p class="product-label" id="QuantityLabel-{{ section.id }}">{{ 'product.quantity' | t }}</p>
{% render 'quantity-stepper',
  id: 'Quantity-',
  index: section.id,
  value: minimum,
  min: minimum,
  max: variant.quantity_rule.max,
  step: increment,
  title: product.title,
  form_id: form_id
%}
{%- if minimum > 1 or increment > 1 or variant.quantity_rule.max -%}
  <p class="muted">{{ 'product.quantity_rule' | t: minimum: minimum, increment: increment }}{% if variant.quantity_rule.max %} {{ 'product.quantity_max' | t: maximum: variant.quantity_rule.max }}{% endif %}</p>
{%- endif -%}
