{%- comment -%}
  Quantity with minus and plus buttons. The number input works on its own; the buttons are enhanced by store.js.
  Params: id (prefix), index, value, min, max, step, title, line (cart line, optional), form_id (optional), name (optional)
{%- endcomment -%}
{%- liquid
  assign field_id = id | append: index
  assign step_value = step | default: 1
  assign field_name = name | default: 'quantity'
  if line
    assign field_name = 'updates[]'
  endif
-%}
<quantity-stepper class="qty">
  <button type="button" class="qty__button" data-step="-1">
    {% render 'icon', icon: 'minus' %}<span class="visually-hidden">{{ 'product.decrease' | t: title: title }}</span>
  </button>
  <label class="visually-hidden" for="{{ field_id }}">{{ 'product.quantity_for' | t: title: title }}</label>
  <input
    class="qty__input"
    id="{{ field_id }}"
    type="number"
    inputmode="numeric"
    name="{{ field_name }}"
    value="{{ value }}"
    min="{{ min }}"
    {% if max %}max="{{ max }}"{% endif %}
    step="{{ step_value }}"
    {% if form_id %}form="{{ form_id }}"{% endif %}
    {% if line %}data-line="{{ line }}"{% endif %}
  >
  <button type="button" class="qty__button" data-step="1">
    {% render 'icon', icon: 'plus' %}<span class="visually-hidden">{{ 'product.increase' | t: title: title }}</span>
  </button>
</quantity-stepper>
