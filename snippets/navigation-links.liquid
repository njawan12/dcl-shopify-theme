<ul class="navigation-list">
  {% for link in menu.links %}
    <li>
      {% if link.links.size > 0 %}
        <details>
          <summary>{{ link.title | escape }}</summary>
          <a href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>{{ 'general.view_all' | t: title: link.title }}</a>
          <ul>
            {% for child in link.links %}
              <li>
                {% if child.links.size > 0 %}
                  <details><summary>{{ child.title | escape }}</summary>
                    <a href="{{ child.url }}">{{ 'general.view_all' | t: title: child.title }}</a>
                    <ul>{% for leaf in child.links %}<li><a href="{{ leaf.url }}" {% if leaf.current %}aria-current="page"{% endif %}>{{ leaf.title | escape }}</a></li>{% endfor %}</ul>
                  </details>
                {% else %}<a href="{{ child.url }}" {% if child.current %}aria-current="page"{% endif %}>{{ child.title | escape }}</a>{% endif %}
              </li>
            {% endfor %}
          </ul>
        </details>
      {% else %}<a href="{{ link.url }}" {% if link.current %}aria-current="page"{% endif %}>{{ link.title | escape }}</a>{% endif %}
    </li>
  {% endfor %}
</ul>
