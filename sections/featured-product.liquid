{% assign featured = section.settings.product | default: product %}
{% render 'product-surface', product: featured, section: section, primary: false %}
{% schema %}
{
  "name": "t:sections.featured",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "t:settings.product"
    }
  ],
  "blocks": [
    {
      "type": "title",
      "name": "t:blocks.title",
      "limit": 1,
      "settings": []
    },
    {
      "type": "vendor",
      "name": "t:blocks.vendor",
      "limit": 1,
      "settings": []
    },
    {
      "type": "price",
      "name": "t:blocks.price",
      "limit": 1,
      "settings": []
    },
    {
      "type": "options",
      "name": "t:blocks.options",
      "limit": 1,
      "settings": []
    },
    {
      "type": "plans",
      "name": "t:blocks.plans",
      "limit": 1,
      "settings": []
    },
    {
      "type": "quantity",
      "name": "t:blocks.quantity",
      "limit": 1,
      "settings": []
    },
    {
      "type": "buy",
      "name": "t:blocks.buy",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "dynamic_checkout",
          "label": "t:settings.dynamic_checkout",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "recipient",
          "label": "t:settings.recipient",
          "default": true
        }
      ]
    },
    {
      "type": "description",
      "name": "t:blocks.description",
      "limit": 1,
      "settings": []
    },
    {
      "type": "pickup",
      "name": "t:blocks.pickup",
      "limit": 1,
      "settings": []
    },
    {
      "type": "liquid",
      "name": "t:blocks.liquid",
      "limit": 3,
      "settings": [
        {
          "type": "liquid",
          "id": "content",
          "label": "t:settings.content"
        }
      ]
    },
    {
      "type": "@app"
    }
  ],
  "max_blocks": 15,
  "presets": [
    {
      "name": "t:sections.featured",
      "blocks": [
        {
          "type": "title"
        },
        {
          "type": "vendor"
        },
        {
          "type": "price"
        },
        {
          "type": "options"
        },
        {
          "type": "plans"
        },
        {
          "type": "quantity"
        },
        {
          "type": "buy"
        },
        {
          "type": "description"
        },
        {
          "type": "pickup"
        }
      ]
    }
  ],
  "disabled_on": {
    "groups": [
      "header",
      "footer"
    ]
  }
}
{% endschema %}
