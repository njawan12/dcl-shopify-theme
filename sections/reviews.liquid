{%- liquid
  assign s = section.settings
  assign scheme = s.scheme | remove: 'scheme'
-%}
<section class="reviews scheme-{{ scheme }} section-space" {% if s.heading != blank %}aria-labelledby="Heading-{{ section.id }}"{% endif %}>
  <div class="page-width">
    <div class="section-head section-head--split">
      <div class="section-intro">
        {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 id="Heading-{{ section.id }}">{{ s.heading | escape }}</h2>{%- endif -%}
        {%- if s.summary != blank -%}<p class="reviews__summary">{{ s.summary | escape }}</p>{%- endif -%}
      </div>
    </div>
    <slide-track class="carousel" style="--columns: 3">
      <ul class="carousel__track" data-track role="list">
        {%- for block in section.blocks -%}
          {%- assign b = block.settings -%}
          <li class="carousel__item" {{ block.shopify_attributes }}>
            <figure class="review-card">
              <div class="rating" aria-hidden="false">
                <span class="rating__stars" style="--rating: {{ b.rating | times: 20 }}%" aria-hidden="true">
                  <span class="rating__base">{%- for i in (1..5) -%}{% render 'icon', icon: 'star' %}{%- endfor -%}</span>
                  <span class="rating__fill">{%- for i in (1..5) -%}{% render 'icon', icon: 'star' %}{%- endfor -%}</span>
                </span>
                <span class="visually-hidden">{{ 'product.rating' | t: rating: b.rating, max: 5 }}</span>
              </div>
              {%- if b.title != blank -%}<p class="review-card__title">{{ b.title | escape }}</p>{%- endif -%}
              <blockquote class="review-card__quote">{{ b.quote }}</blockquote>
              <figcaption class="review-card__author">
                <span>{{ b.author | escape }}</span>
                {%- if b.verified -%}<span class="review-card__verified">{% render 'icon', icon: 'check' %} {{ 'general.verified' | t }}</span>{%- endif -%}
              </figcaption>
              {%- if b.product != blank -%}
                <a class="review-card__product" href="{{ b.product.url }}">
                  {%- if b.product.featured_media -%}{{ b.product.featured_media | image_url: width: 120 | image_tag: sizes: '2.75rem', loading: 'lazy', alt: '' }}{%- endif -%}
                  <span>{{ b.product.title | escape }}</span>
                </a>
              {%- endif -%}
            </figure>
          </li>
        {%- endfor -%}
      </ul>
      <div class="carousel__nav">
        <button type="button" class="carousel__arrow" data-track-prev>{% render 'icon', icon: 'chevron-left' %}<span class="visually-hidden">{{ 'general.previous' | t }}</span></button>
        <button type="button" class="carousel__arrow" data-track-next>{% render 'icon', icon: 'chevron-right' %}<span class="visually-hidden">{{ 'general.next' | t }}</span></button>
      </div>
    </slide-track>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.reviews",
  "tag": "div",
  "class": "section-reviews",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.eyebrow",
      "default": "Reviews"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Loved by customers"
    },
    {
      "type": "text",
      "id": "summary",
      "label": "t:settings.summary",
      "info": "t:info.summary"
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "t:settings.scheme",
      "default": "scheme2",
      "options": [
        {
          "value": "scheme1",
          "label": "t:options.scheme1"
        },
        {
          "value": "scheme2",
          "label": "t:options.scheme2"
        },
        {
          "value": "scheme3",
          "label": "t:options.scheme3"
        },
        {
          "value": "scheme4",
          "label": "t:options.scheme4"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "t:blocks.review",
      "limit": 12,
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "label": "t:settings.rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "default": 5
        },
        {
          "type": "text",
          "id": "title",
          "label": "t:settings.title",
          "default": "My new daily favourite"
        },
        {
          "type": "richtext",
          "id": "quote",
          "label": "t:settings.quote",
          "default": "<p>Share a review from a real customer here.</p>"
        },
        {
          "type": "text",
          "id": "author",
          "label": "t:settings.author",
          "default": "Customer name"
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "t:settings.verified",
          "default": true
        },
        {
          "type": "product",
          "id": "product",
          "label": "t:settings.product"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.reviews",
      "blocks": [
        {
          "type": "review"
        },
        {
          "type": "review"
        },
        {
          "type": "review"
        }
      ]
    }
  ]
}
{% endschema %}
