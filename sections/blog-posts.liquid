{%- liquid
  assign s = section.settings
  assign scheme = s.scheme | remove: 'scheme'
  assign b = s.blog
-%}
<section class="blog-posts scheme-{{ scheme }} section-space" {% if s.heading != blank %}aria-labelledby="Heading-{{ section.id }}"{% endif %}>
  <div class="page-width">
    <div class="section-head section-head--split">
      <div class="section-intro">
        {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
        {%- if s.heading != blank -%}<h2 id="Heading-{{ section.id }}">{{ s.heading | escape }}</h2>{%- endif -%}
      </div>
      {%- if b != blank -%}<a class="text-link" href="{{ b.url }}">{{ 'general.view_all_short' | t }}</a>{%- endif -%}
    </div>
    <ul class="post-grid" role="list">
      {%- if b != blank and b.articles_count > 0 -%}
        {%- for article in b.articles limit: s.limit -%}
          <li class="post-card" data-reveal>
            <a class="post-card__media" href="{{ article.url }}" tabindex="-1" aria-hidden="true">
              {%- if article.image -%}{{ article.image | image_url: width: 1000 | image_tag: widths: '400,600,800,1000', sizes: '(min-width: 990px) 33vw, (min-width: 600px) 50vw, 100vw', loading: 'lazy', alt: '' }}{%- else -%}{{ 'lifestyle-1' | placeholder_svg_tag: 'placeholder-svg' }}{%- endif -%}
            </a>
            <p class="post-card__meta">{{ article.published_at | time_tag: format: 'date' }}</p>
            <h3 class="post-card__title"><a href="{{ article.url }}">{{ article.title | escape }}</a></h3>
            {%- if s.excerpt -%}<p class="post-card__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 22 }}</p>{%- endif -%}
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..3) -%}
          <li class="post-card">
            <div class="post-card__media">{{ 'lifestyle-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}</div>
            <h3 class="post-card__title">{{ 'canvas.sample_article' | t }}</h3>
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.blog_posts",
  "tag": "div",
  "class": "section-blog-posts",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.eyebrow",
      "default": "Journal"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "From the journal"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "t:settings.blog"
    },
    {
      "type": "range",
      "id": "limit",
      "label": "t:settings.posts_to_show",
      "min": 2,
      "max": 6,
      "step": 1,
      "default": 3
    },
    {
      "type": "checkbox",
      "id": "excerpt",
      "label": "t:settings.show_excerpt",
      "default": true
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "t:settings.scheme",
      "default": "scheme1",
      "options": [
        {
          "value": "scheme1",
          "label": "t:options.scheme1"
        },
        {
          "value": "scheme2",
          "label": "t:options.scheme2"
        },
        {
          "value": "scheme3",
          "label": "t:options.scheme3"
        },
        {
          "value": "scheme4",
          "label": "t:options.scheme4"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.blog_posts"
    }
  ]
}
{% endschema %}
