{%- liquid
  assign s = section.settings
  assign scheme = s.scheme | remove: 'scheme'
  assign limit = s.limit | plus: 0
  assign stories = section.blocks | where: 'type', 'story'
  assign story_cells = stories.size | times: 2
  assign limit = limit | minus: story_cells
  if s.cadence == 'lead'
    assign limit = limit | minus: 3
  endif
  if limit < 2
    assign limit = 2
  endif
  assign story_at = 3
  if s.cadence == 'lead'
    assign story_at = 5
  endif
-%}
<section class="commerce-mosaic mosaic--{{ s.cadence }} scheme-{{ scheme }} section-space" {% if s.heading != blank %}aria-labelledby="Heading-{{ section.id }}"{% endif %}>
  <div class="page-width">
    <div class="section-head">
      {%- if s.eyebrow != blank or s.heading != blank -%}
  <div class="section-intro">
    {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
    {%- if s.heading != blank -%}<h2 id="Heading-{{ section.id }}">{{ s.heading | escape }}</h2>{%- endif -%}
    {%- if s.text != blank -%}<div class="rich-text section-intro__text">{{ s.text }}</div>{%- endif -%}
  </div>
{%- endif -%}
      {%- if s.collection != blank and s.button_label != blank -%}
        <a class="text-link" href="{{ s.collection.url }}">{{ s.button_label | escape }}<span class="visually-hidden">: {{ s.collection.title | escape }}</span></a>
      {%- endif -%}
    </div>
    <ul class="mosaic-grid" role="list">
      {%- if s.collection != blank and s.collection.products_count > 0 -%}
        {%- for product in s.collection.products limit: limit -%}
          <li class="mosaic-item{% if forloop.first and s.cadence == 'lead' %} mosaic-item--lead{% endif %}">{% render 'product-card', product: product %}</li>
          {%- if forloop.index == story_at and s.cadence != 'grid' and stories.size > 0 -%}
            {%- assign block = stories.first -%}{%- render 'mosaic-story', block: block -%}
          {%- endif -%}
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..limit) -%}
          <li class="mosaic-item{% if forloop.first and s.cadence == 'lead' %} mosaic-item--lead{% endif %}">
            <article class="product-card product-card--sample">
              {%- capture placeholder -%}product-{{ i | minus: 1 | modulo: 6 | plus: 1 }}{%- endcapture -%}
              {{ placeholder | placeholder_svg_tag: 'placeholder-svg' }}
              <h3>{{ 'canvas.sample_product' | t }}</h3>
              <p>{{ 4900 | money_with_currency }}</p>
            </article>
          </li>
          {%- if forloop.index == story_at and s.cadence != 'grid' and stories.size > 0 -%}
            {%- assign block = stories.first -%}{%- render 'mosaic-story', block: block -%}
          {%- endif -%}
        {%- endfor -%}
      {%- endif -%}
      {%- if stories.size > 1 -%}{%- render 'mosaic-story', block: stories.last -%}{%- endif -%}
      {%- if s.cadence == 'grid' and stories.size == 1 -%}{%- render 'mosaic-story', block: stories.first -%}{%- endif -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.commerce_mosaic",
  "tag": "div",
  "class": "section-commerce-mosaic",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.eyebrow"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Shop the edit"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:settings.text"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "t:settings.collection"
    },
    {
      "type": "select",
      "id": "cadence",
      "label": "t:settings.cadence",
      "default": "story",
      "options": [
        {
          "value": "grid",
          "label": "t:options.grid"
        },
        {
          "value": "lead",
          "label": "t:options.lead"
        },
        {
          "value": "story",
          "label": "t:options.story"
        }
      ],
      "info": "t:info.cadence"
    },
    {
      "type": "select",
      "id": "limit",
      "label": "t:settings.limit",
      "default": "8",
      "options": [
        {
          "value": "4",
          "label": "t:options.4"
        },
        {
          "value": "8",
          "label": "t:options.8"
        },
        {
          "value": "12",
          "label": "t:options.12"
        }
      ]
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "t:settings.button_label",
      "default": "View all"
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "t:settings.scheme",
      "default": "scheme1",
      "options": [
        {
          "value": "scheme1",
          "label": "t:options.scheme1"
        },
        {
          "value": "scheme2",
          "label": "t:options.scheme2"
        },
        {
          "value": "scheme3",
          "label": "t:options.scheme3"
        },
        {
          "value": "scheme4",
          "label": "t:options.scheme4"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "story",
      "name": "t:blocks.story",
      "limit": 2,
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "t:settings.image"
        },
        {
          "type": "text",
          "id": "heading",
          "label": "t:settings.heading",
          "default": "Why it works"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:settings.text",
          "default": "A short story that helps shoppers choose."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "t:settings.button_label",
          "default": "Read more"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "t:settings.button_link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.commerce_mosaic",
      "blocks": [
        {
          "type": "story"
        }
      ]
    }
  ]
}
{% endschema %}
