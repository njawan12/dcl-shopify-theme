{%- liquid
  assign s = section.settings
  assign scheme = s.scheme | remove: 'scheme'
-%}
{%- if s.text != blank -%}
  <div class="announcement-bar scheme-{{ scheme }}">
    <p class="page-width">
      {%- if s.link != blank -%}<a href="{{ s.link }}">{{ s.text | escape }}</a>{%- else -%}{{ s.text | escape }}{%- endif -%}
    </p>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.announcement",
  "tag": "div",
  "class": "section-announcement",
  "enabled_on": {
    "groups": [
      "header"
    ]
  },
  "settings": [
    {
      "type": "text",
      "id": "text",
      "label": "t:settings.text",
      "default": "Free shipping on orders over $50"
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link"
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "t:settings.scheme",
      "default": "scheme3",
      "options": [
        {
          "value": "scheme1",
          "label": "t:options.scheme1"
        },
        {
          "value": "scheme2",
          "label": "t:options.scheme2"
        },
        {
          "value": "scheme3",
          "label": "t:options.scheme3"
        },
        {
          "value": "scheme4",
          "label": "t:options.scheme4"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "t:sections.announcement"
    }
  ]
}
{% endschema %}
