<div class="page-width section-space"><h1>{{ blog.title | escape }}</h1>{% paginate blog.articles by 12 %}
  <div class="product-grid">{% for article in blog.articles %}<article><a href="{{ article.url }}">{% if article.image %}{% render 'image', image: article.image, alt: article.image.alt, sizes: '(min-width: 750px) 33vw, 100vw' %}{% endif %}<h2>{{ article.title | escape }}</h2></a><p>{{ article.excerpt_or_content | strip_html | truncatewords: 40 }}</p></article>{% else %}<p>{{ 'blog.empty' | t }}</p>{% endfor %}</div>
  {% render 'pagination', paginate: paginate %}{% endpaginate %}</div>

{% schema %}
{
  "name": "t:sections.blog",
  "settings": []
}
{% endschema %}
