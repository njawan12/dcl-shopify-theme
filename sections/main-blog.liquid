<div class="page-width section-space">
  <h1>{{ blog.title | escape }}</h1>
  {%- paginate blog.articles by 12 -%}
    <ul class="article-grid" role="list">
      {%- for article in blog.articles -%}
        <li class="article-card">
          <article>
            <a href="{{ article.url }}">
              {%- if article.image -%}{% render 'image', image: article.image, alt: article.image.alt, sizes: '(min-width: 990px) 33vw, (min-width: 600px) 50vw, 100vw' %}{%- endif -%}
              <p class="article-meta"><time datetime="{{ article.published_at | date: '%Y-%m-%d' }}">{{ article.published_at | date: format: 'date' }}</time></p>
              <h2>{{ article.title | escape }}</h2>
            </a>
            <p>{{ article.excerpt_or_content | strip_html | truncatewords: 30 }}</p>
          </article>
        </li>
      {%- else -%}
        <li><p>{{ 'blog.empty' | t }}</p></li>
      {%- endfor -%}
    </ul>
    {% render 'pagination', paginate: paginate %}
  {%- endpaginate -%}
</div>

{% schema %}
{
  "name": "t:sections.blog",
  "settings": []
}
{% endschema %}
