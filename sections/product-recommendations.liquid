{%- liquid
  assign s = section.settings
  assign scheme = s.scheme | remove: 'scheme'
-%}
{%- if product != blank -%}
  <product-recommendations
    class="product-recs scheme-{{ scheme }} section-space"
    data-url="{{ routes.product_recommendations_url }}?section_id={{ section.id }}&product_id={{ product.id }}&limit={{ s.limit }}&intent={{ s.intent }}"
  >
    {%- if recommendations.performed and recommendations.products_count > 0 -%}
      <div class="page-width">
        {%- if s.heading != blank -%}<h2 class="product-recs__heading">{{ s.heading | escape }}</h2>{%- endif -%}
        <ul class="mosaic-grid product-recs__grid" role="list">
          {%- for rec in recommendations.products -%}
            <li class="mosaic-item">{% render 'product-card', product: rec %}</li>
          {%- endfor -%}
        </ul>
      </div>
    {%- endif -%}
  </product-recommendations>
  <script src="{{ 'recommendations.js' | asset_url }}" type="module"></script>
{%- endif -%}

{% schema %}
{
  "name": "t:sections.recommendations",
  "tag": "div",
  "class": "section-product-recommendations",
  "enabled_on": { "templates": ["product"] },
  "settings": [
    {
      "type": "select",
      "id": "intent",
      "label": "t:settings.intent",
      "default": "related",
      "options": [
        { "value": "related", "label": "t:options.related" },
        { "value": "complementary", "label": "t:options.complementary" }
      ],
      "info": "t:info.intent"
    },
    { "type": "text", "id": "heading", "label": "t:settings.heading", "default": "You may also like" },
    {
      "type": "select",
      "id": "limit",
      "label": "t:settings.limit",
      "default": "4",
      "options": [
        { "value": "4", "label": "t:options.4" },
        { "value": "8", "label": "t:options.8" }
      ]
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "t:settings.scheme",
      "default": "scheme1",
      "options": [
        { "value": "scheme1", "label": "t:options.scheme1" },
        { "value": "scheme2", "label": "t:options.scheme2" },
        { "value": "scheme3", "label": "t:options.scheme3" },
        { "value": "scheme4", "label": "t:options.scheme4" }
      ]
    }
  ],
  "presets": [{ "name": "t:sections.recommendations" }]
}
{% endschema %}
