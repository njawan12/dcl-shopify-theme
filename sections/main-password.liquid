<div class="page-width reading-width section-space"><h1>{{ shop.name | escape }}</h1>{% if shop.password_message != blank %}<p>{{ shop.password_message }}</p>{% endif %}
{% assign password_id = 'Password-' | append: section.id %}{% form 'storefront_password', id: password_id %}{{ form.errors | default_errors }}<label for="PasswordInput">{{ 'general.password' | t }}</label><input id="PasswordInput" type="password" name="password" autocomplete="current-password" required><button>{{ 'general.enter' | t }}</button>{% endform %}
{{ powered_by_link }}</div>

{% schema %}
{
  "name": "t:sections.password",
  "settings": []
}
{% endschema %}
