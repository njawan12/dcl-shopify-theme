{%- liquid
  assign s = section.settings
  assign scheme = s.scheme | remove: 'scheme'
-%}
<section class="guided-set scheme-1" aria-labelledby="Heading-{{ section.id }}">
  <div class="page-width guided-set__grid">
    <div class="guided-set__panel scheme-{{ scheme }}">
      {%- if s.eyebrow != blank -%}<p class="eyebrow">{{ s.eyebrow | escape }}</p>{%- endif -%}
      <h2 id="Heading-{{ section.id }}" class="guided-set__heading">{{ s.heading | escape }}</h2>
      {%- if s.text != blank -%}<div class="rich-text">{{ s.text }}</div>{%- endif -%}
      {%- if s.footnote != blank -%}<p class="guided-set__footnote">{{ s.footnote | escape }}</p>{%- endif -%}
    </div>

    <guided-set class="guided-set__steps" data-add-url="{{ routes.cart_add_url }}" data-cart-url="{{ routes.cart_url }}" data-currency="{{ cart.currency.iso_code }}" data-locale="{{ request.locale.iso_code }}">
      <ol class="guided-steps" role="list">
        {%- for block in section.blocks -%}
          {%- assign p = block.settings.product -%}
          <li class="guided-step" {{ block.shopify_attributes }}>
            <p class="guided-step__label"><span class="guided-step__index">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span> {{ block.settings.label | escape }}</p>
            {%- if block.settings.text != blank -%}<p class="guided-step__text">{{ block.settings.text | escape }}</p>{%- endif -%}
            {%- if p != blank -%}
              {%- assign v = p.selected_or_first_available_variant -%}
              <div class="guided-step__product">
                <a class="guided-step__media" href="{{ p.url }}" tabindex="-1" aria-hidden="true">{% render 'image', image: p.featured_media.preview_image, alt: '', sizes: '(min-width: 750px) 180px, 40vw', eager: false %}</a>
                <div class="guided-step__info">
                  <h3><a href="{{ p.url }}">{{ p.title | escape }}</a></h3>
                  {%- render 'price', variant: v -%}
                  {%- if p.has_only_default_variant and v.available and p.requires_selling_plan == false -%}
                    <label class="guided-step__check" hidden>
                      <input type="checkbox" value="{{ v.id }}" data-price="{{ v.price }}">
                      {{ 'canvas.include' | t: title: p.title }}
                    </label>
                    {%- assign form_id = 'GuidedSet-' | append: block.id -%}
                    {%- form 'product', p, id: form_id, class: 'guided-step__form' -%}
                      <input type="hidden" name="id" value="{{ v.id }}">
                      <button type="submit" name="add">{{ 'product.add' | t }}<span class="visually-hidden">: {{ p.title | escape }}</span></button>
                    {%- endform -%}
                  {%- elsif v.available -%}
                    <a class="text-link" href="{{ p.url }}">{{ 'canvas.choose_options' | t }}<span class="visually-hidden">: {{ p.title | escape }}</span></a>
                  {%- endif -%}
                </div>
              </div>
            {%- else -%}
              <div class="guided-step__product guided-step__product--empty">
                <div class="guided-step__media">{{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}</div>
                <div class="guided-step__info"><h3>{{ 'canvas.sample_product' | t }}</h3></div>
              </div>
            {%- endif -%}
          </li>
        {%- endfor -%}
      </ol>
      <div class="guided-summary" hidden>
        <p class="eyebrow">{{ 'canvas.selection' | t }}</p>
        <p aria-live="polite"><span data-count>0</span> {{ 'canvas.selected_label' | t }}</p>
        <p class="guided-summary__total" data-total>{{ 0 | money_with_currency }}</p>
        <p class="guided-summary__help">{{ 'canvas.selection_total_help' | t }}</p>
        <p class="guided-summary__error" data-error role="alert" hidden>{{ 'canvas.add_error' | t }}</p>
        <button type="button" class="button" data-add disabled>{{ 'canvas.add_selected' | t }}</button>
      </div>
    </guided-set>
  </div>
</section>
<script src="{{ 'guided-set.js' | asset_url }}" type="module"></script>

{% schema %}
{
  "name": "t:sections.guided_set",
  "tag": "div",
  "class": "section-guided-set",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "t:settings.eyebrow",
      "default": "A considered routine"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Less, with intention."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "t:settings.text",
      "default": "<p>Walk shoppers through each step, then let them add only what they want.</p>"
    },
    {
      "type": "text",
      "id": "footnote",
      "label": "t:settings.footnote",
      "default": "Individual products. Your own rhythm."
    },
    {
      "type": "select",
      "id": "scheme",
      "label": "t:settings.scheme",
      "default": "scheme3",
      "options": [
        {
          "value": "scheme1",
          "label": "t:options.scheme1"
        },
        {
          "value": "scheme2",
          "label": "t:options.scheme2"
        },
        {
          "value": "scheme3",
          "label": "t:options.scheme3"
        },
        {
          "value": "scheme4",
          "label": "t:options.scheme4"
        }
      ]
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "t:blocks.step",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "t:settings.label",
          "default": "Begin gently"
        },
        {
          "type": "text",
          "id": "text",
          "label": "t:settings.text",
          "default": "Describe why this step matters."
        },
        {
          "type": "product",
          "id": "product",
          "label": "t:settings.product"
        }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "t:sections.guided_set",
      "blocks": [
        {
          "type": "step",
          "settings": {
            "label": "Cleanse"
          }
        },
        {
          "type": "step",
          "settings": {
            "label": "Treat"
          }
        },
        {
          "type": "step",
          "settings": {
            "label": "Protect"
          }
        }
      ]
    }
  ]
}
{% endschema %}
