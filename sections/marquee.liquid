{%- liquid
  assign s = section.settings
  assign scheme = s.scheme | remove: 'scheme'
-%}
{%- capture items -%}
  {%- for block in section.blocks -%}
    <li class="marquee__item" {{ block.shopify_attributes }}>
      {%- if block.settings.link != blank -%}<a href="{{ block.settings.link }}">{{ block.settings.text | escape }}</a>{%- else -%}<span>{{ block.settings.text | escape }}</span>{%- endif -%}
      {%- if s.separator != 'none' -%}<span class="marquee__sep" aria-hidden="true">{% render 'icon', icon: s.separator %}</span>{%- endif -%}
    </li>
  {%- endfor -%}
{%- endcapture -%}
<section class="marquee marquee--{{ s.size }} scheme-{{ scheme }}" style="--marquee-speed: {{ s.speed }}s">
  <div class="marquee__track">
    <ul class="marquee__list" role="list">{{ items }}</ul>
    <ul class="marquee__list" role="list" aria-hidden="true">{{ items }}</ul>
    <ul class="marquee__list" role="list" aria-hidden="true">{{ items }}</ul>
  </div>
</section>

{% schema %}
{
  "name": "t:sections.marquee",
  "tag": "div",
  "class": "section-marquee",
  "settings": [
    {
      "type": "select",
      "id": "size",
      "label": "t:settings.text_size",
      "default": "medium",
