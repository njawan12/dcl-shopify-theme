    {
      "type": "range",
      "id": "speed",
      "label": "t:settings.speed",
      "info": "t:info.speed",
      "min": 10,
      "max": 80,
      "step": 5,
      "unit": "s",
      "default": 35
    },
    {
      "type": "select",
      "id": "separator",
      "label": "t:settings.separator",
      "default": "sparkle",
      "options": [
        {
          "value": "none",
          "label": "t:icons.none"
